# Environment
NODE_ENV=production
PORT=3000

# MongoDB URI (MongoDB Atlas or docker service)
# Contoh Atlas: mongodb+srv://username:password@cluster.mongodb.net/expense-tracker?retryWrites=true&w=majority
# Contoh Docker Mongo Lokal: mongodb://admin:password_rahasia_kamu@mongo:27017/expense-tracker?authSource=admin
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/expense-tracker?retryWrites=true&w=majority

# JWT Auth Secret
SECRET_KEY=ganti_dengan_random_secret_key_yang_panjang_dan_aman

# Frontend Client URL (Domain frontend di Vercel / Netlify / Custom Domain)
CLIENT_URL=https://your-frontend-domain.com

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
